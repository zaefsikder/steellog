    {
      "id": "hybrid",
      "name": "Hybrid Mobility + Hypertrophy",
      "subtitle": "3–4 Days / Week - 45–60 Min",
      "days": [
        {
          "id": "hybrid-day-a",
          "label": "Day A",
          "title": "Lower Body — Mobility + Squat Pattern + Hinge",
          "exercises": [
            {
              "id": "hybrid-day-a-platz-stretch",
              "name": "Platz Stretch",
              "category": "Mobility",
              "sets": "3",
              "reps": "45–60s hold",
              "weight": "",
              "notes": "Deep squat hold, elbows push knees out, breathe into stretch"
            },
            {
              "id": "hybrid-day-a-zercher-hack-squat",
              "name": "Zercher / Hack Squat",
              "category": "Strength",
              "sets": "4",
              "reps": "5–8",
              "weight": "",
              "notes": "Alternate Zercher & Hack each session; Zercher: elbows locked, upright torso"
            },
            {
              "id": "hybrid-day-a-bulgarian-split-squat",
              "name": "Bulgarian Split Squat",
              "category": "Hypertrophy",
              "sets": "3",
              "reps": "8–10 / leg",
              "weight": "",
              "notes": "Rear foot on bench, vertical front shin, knee tracks toe"
            },
            {
              "id": "hybrid-day-a-rdl",
              "name": "RDL",
              "category": "Strength",
              "sets": "3–4",
              "reps": "8–10",
              "weight": "",
              "notes": "Hip hinge — not a squat; bar drags down leg, neutral spine throughout"
            },
            {
              "id": "hybrid-day-a-horse-stance-good-morning",
              "name": "Horse Stance Good Morning",
              "category": "Mobility",
              "sets": "3",
              "reps": "10",
              "weight": "",
              "notes": "Wide stance, hinge at hip, long spine, feel hamstrings load"
            },
            {
              "id": "hybrid-day-a-calf-extensions",
              "name": "Calf Extensions",
              "category": "Mobility",
              "sets": "3",
              "reps": "15–20",
              "weight": "",
              "notes": "Full ROM: pause at bottom stretch and top contraction; no bouncing"
            }
          ]
        },
        {
          "id": "hybrid-day-b",
          "label": "Day B",
          "title": "Push — Chest + Shoulders + Triceps",
          "exercises": [
            {
              "id": "hybrid-day-b-smith-machine-incline-press",
              "name": "Smith Machine Incline Press",
              "category": "Hypertrophy",
              "sets": "4",
              "reps": "8–12",
              "weight": "",
              "notes": "30° incline, bar to upper chest, 2–3s descent, full lockout"
            },
            {
              "id": "hybrid-day-b-overhead-press",
              "name": "Overhead Press",
              "category": "Strength",
              "sets": "3–4",
              "reps": "6–10",
              "weight": "",
              "notes": "Strict press; brace core, bar starts at clavicle, full lockout overhead"
            },
            {
              "id": "hybrid-day-b-lateral-raise",
              "name": "Lateral Raise",
              "category": "Hypertrophy",
              "sets": "3",
              "reps": "15–20",
              "weight": "",
              "notes": "Lead with elbow, slight forward lean, thumb slightly down; no swing"
            },
            {
              "id": "hybrid-day-b-dips",
              "name": "Dips",
              "category": "Strength",
              "sets": "3",
              "reps": "8–12",
              "weight": "",
              "notes": "Slight forward lean for chest; add weight when 12+ reps clean"
            },
            {
              "id": "hybrid-day-b-katana-extension",
              "name": "Katana Extension",
              "category": "Hypertrophy",
              "sets": "3",
              "reps": "12–15",
              "weight": "",
              "notes": "Cable overhead; elbows fixed, slow eccentric, full stretch at top"
            },
            {
              "id": "hybrid-day-b-tricep-pulldown",
              "name": "Tricep Pulldown",
              "category": "Hypertrophy",
              "sets": "3",
              "reps": "12–15",
              "weight": "",
              "notes": "Elbows pinned to sides, full lockout each rep; try rope for extra ROM"
            }
          ]
        },
        {
          "id": "hybrid-day-c",
          "label": "Day C",
          "title": "Pull + Biceps + Core — Back Width + Arm Flexors + Core",
          "exercises": [
            {
              "id": "hybrid-day-c-pull-ups",
              "name": "Pull-Ups",
              "category": "Strength",
              "sets": "4",
              "reps": "max (weighted when 12+)",
              "weight": "",
              "notes": "Dead hang start, full extension at bottom; add load with belt"
            },
            {
              "id": "hybrid-day-c-front-lever",
              "name": "Front Lever",
              "category": "Skill/Core",
              "sets": "3",
              "reps": "max hold",
              "weight": "",
              "notes": "Tuck → adv. tuck → straddle; depress scaps, hollow body, arms straight"
            },
            {
              "id": "hybrid-day-c-cable-row",
              "name": "Cable Row",
              "category": "Hypertrophy",
              "sets": "3–4",
              "reps": "10–12",
              "weight": "",
              "notes": "Slight lean at start, pull to navel, retract scaps at peak"
            },
            {
              "id": "hybrid-day-c-bayesian-curl",
              "name": "Bayesian Curl",
              "category": "Hypertrophy",
              "sets": "3",
              "reps": "12–15",
              "weight": "",
              "notes": "Cable behind body, step forward to load stretch, full extension at bottom"
            },
            {
              "id": "hybrid-day-c-preacher-curl",
              "name": "Preacher Curl",
              "category": "Hypertrophy",
              "sets": "3",
              "reps": "10–12",
              "weight": "",
              "notes": "Upper arm fully on pad; slow 3s descent; don't lift off pad at top"
            },
            {
              "id": "hybrid-day-c-hanging-leg-raise",
              "name": "Hanging Leg Raise",
              "category": "Core",
              "sets": "3",
              "reps": "12–15",
              "weight": "",
              "notes": "Posterior pelvic tilt, no swing, controlled descent; progress to toes-to-bar"
            }
          ]
        },
        {
          "id": "hybrid-day-d",
          "label": "Day D",
          "title": "Posterior Chain + Core — Hip Hinge Power + Hamstrings + Core",
          "exercises": [
            {
              "id": "hybrid-day-d-kb-swings",
              "name": "KB Swings",
              "category": "Strength",
              "sets": "4",
              "reps": "15–20",
              "weight": "",
              "notes": "Hip snap — not a squat; hike bell back, neutral spine, glute squeeze at top"
            },
            {
              "id": "hybrid-day-d-seated-lying-leg-curl",
              "name": "Seated / Lying Leg Curl",
              "category": "Hypertrophy",
              "sets": "3",
              "reps": "12–15",
              "weight": "",
              "notes": "Full ROM, squeeze hard at peak contraction, 2–3s lowering phase"
            },
            {
              "id": "hybrid-day-d-roman-chair-hyperext",
              "name": "Roman Chair Hyperext.",
              "category": "Core",
              "sets": "3",
              "reps": "12–15",
              "weight": "",
              "notes": "Hinge at hip, neutral spine at top; add plate to chest when 20+ easy"
            },
            {
              "id": "hybrid-day-d-v-ups",
              "name": "V-Ups",
              "category": "Core",
              "sets": "3",
              "reps": "15–20",
              "weight": "",
              "notes": "Full extension on descent, meet hands to feet; progress to weighted"
            }
          ]
        }
      ]
    }
  ]
